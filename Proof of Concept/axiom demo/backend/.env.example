# Optional. Set this to switch the evaluator from offline (rule engine) to
# live (Claude plays the target). The backend reads it from the environment,
# not this file directly — export it in your shell before running uvicorn,
# e.g.:
#
#   export ANTHROPIC_API_KEY=sk-ant-your-key-here   # macOS / Linux
#   $env:ANTHROPIC_API_KEY="sk-ant-..."             # Windows PowerShell
ANTHROPIC_API_KEY=
